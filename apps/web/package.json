{
  "name": "@monkeyspaw/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The Monkey's Paw web app.",
  "license": "MIT",
  "scripts": {
    "predev": "node scripts/copy-paw-assets.mjs",
    "dev": "vite",
    "prebuild": "node scripts/copy-paw-assets.mjs",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "paw-core": "workspace:*",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.187.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "fast-check": "^3.23.0",
    "fflate": "^0.8.3",
    "jsdom": "^26.1.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.0.0",
    "vite": "^5.4.10",
    "vitest": "^2.1.8"
  }
}

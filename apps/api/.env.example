# Gemini API key - required for model calls; leave blank for examples-only mode
GEMINI_API_KEY=

# Gemini primary model name (default: gemini-3.5-flash)
# Task 95: Resilience with model fallbacks
GEMINI_MODEL=gemini-3.5-flash

# Gemini model fallback list for 503/429 resilience (default: gemini-3.8-flash,gemini-flash-latest,gemini-2.5-flash)
# Task 95: Tried on high demand; comma-separated list
GEMINI_MODEL_FALLBACKS=gemini-3.8-flash,gemini-flash-latest,gemini-2.5-flash

# CORS origin for the web app
CORS_ORIGIN=http://localhost:5173

# Rate limit: max calls per IP within a window (default 10)
PER_IP_LIMIT=10

# Rate limit: window duration in milliseconds (default 60000 = 1 minute)
RATE_WINDOW_MS=60000

# Daily budget in cents USD (default 500 = $5)
DAILY_BUDGET_CENTS=500

# Eval quality gate: minimum specificity score required to pass (0–1, default 0.80)
EVAL_SPECIFICITY_THRESHOLD=0.80

# Gemini API key - required for model calls; leave blank for examples-only mode
GEMINI_API_KEY=

# Gemini tier: "paid" only for a key from a project with billing; anything else (or unset) is free
GEMINI_TIER=

# The one request header that holds the visitor's country (for example set by a host in front of this server).
# Unset: every live wish is refused. Set it only where that host overwrites it and nothing can reach this
# server around that host. See "Who may make live wishes" in the README.
COUNTRY_HEADER=

# Gemini primary model name (default: gemini-3.6-flash; the retired name gemini-3.5-flash routes to it)
# Task 95: Resilience with model fallbacks
GEMINI_MODEL=gemini-3.6-flash

# Gemini model fallback list for 503/429/404 resilience
# Task 99: Removed gemini-2.5-flash (returns 404 now)
GEMINI_MODEL_FALLBACKS=gemini-3.8-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite

# Gemini request timeout in milliseconds (default 30000)
GEMINI_TIMEOUT_MS=30000

# Port the server listens on (default 8787)
PORT=8787

# Optional: replace the built-in model price table (USD per 1M tokens), as one line of JSON:
# {"<model id>":{"inputUsdPerMTok":1.5,"outputUsdPerMTok":7.5}}
# PRICE_TABLE_JSON=

# Optional: path of the examples cache (default apps/api/examples-cache.json, found from the package)
# EXAMPLES_CACHE_PATH=

# CORS origin for the web app
CORS_ORIGIN=http://localhost:5173

# Rate limit: max calls per IP within a window (default 10)
PER_IP_LIMIT=10

# Rate limit: window duration in milliseconds (default 60000 = 1 minute)
RATE_WINDOW_MS=60000

# Daily budget in cents USD, default 200 ($2 a day); a fractional value is fine
DAILY_BUDGET_CENTS=200

# Proxies in front of this server that append to x-forwarded-for (default 1; 0 when nothing sits in front)
TRUSTED_PROXY_HOPS=1

# Eval quality gate: minimum specificity score required to pass (0–1, default 0.80)
EVAL_SPECIFICITY_THRESHOLD=0.80
